# Copy this file to .env and fill in values from
# Supabase Dashboard -> Project Settings -> API.
# Use the publishable key (sb_publishable_...) or legacy anon key. NEVER put the secret/service_role key in the app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
